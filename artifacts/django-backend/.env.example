# IslamicTube Django Backend — Environment Variables
# Copy this file to .env and fill in values before deploying
# Never commit .env to version control

# ── Security ──────────────────────────────────────────────────────
# Generate a strong random key: python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-strong-random-key

# Set to "False" in production
DJANGO_DEBUG=False

# Comma-separated list of allowed hostnames in production
# e.g. DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ── JWT ───────────────────────────────────────────────────────────
# Separate signing key for JWTs (can be same as SECRET_KEY but better to differ)
JWT_SIGNING_KEY=replace-with-another-strong-random-key

# ── CORS ──────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins in production
# e.g. CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com
# Leave blank to allow all origins (development only)
CORS_ALLOWED_ORIGINS=

# ── Rate Limiting ─────────────────────────────────────────────────
THROTTLE_ANON_RATE=120/min
THROTTLE_USER_RATE=300/min
